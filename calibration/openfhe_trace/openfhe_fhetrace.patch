diff --git a/src/core/include/utils/fhetrace.h b/src/core/include/utils/fhetrace.h
new file mode 100644
index 0000000..1e47077
--- /dev/null
+++ b/src/core/include/utils/fhetrace.h
@@ -0,0 +1,43 @@
+// fhetrace: a minimal kernel-stream tracer added for FHE_Accelerator_Sim (not part of OpenFHE).
+// Active only when the environment has FHETRACE=<file> and FHETRACE_ON=1. Each shared library
+// gets its own FILE*, so the file is opened unbuffered in append mode: lines from every library
+// land in program order (run single-threaded: OMP_NUM_THREADS=1).
+#ifndef OPENFHE_FHETRACE_H
+#define OPENFHE_FHETRACE_H
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+namespace fhetrace {
+inline FILE* out() {
+    static FILE* f = []() -> FILE* {
+        const char* p = std::getenv("FHETRACE");
+        if (!p)
+            return nullptr;
+        FILE* g = std::fopen(p, "a");
+        if (g)
+            std::setvbuf(g, nullptr, _IONBF, 0);
+        return g;
+    }();
+    return f;
+}
+inline bool on() {
+    const char* e = std::getenv("FHETRACE_ON");
+    return out() != nullptr && e != nullptr && e[0] == '1';
+}
+template <class... A>
+inline void emit(const char* fmt, A... a) {
+    if (!on())
+        return;
+    static std::mutex m;
+    std::lock_guard<std::mutex> g(m);
+    char buf[256];
+    int n;
+    if constexpr (sizeof...(A) == 0)
+        n = std::snprintf(buf, sizeof(buf) - 1, "%s", fmt);
+    else
+        n = std::snprintf(buf, sizeof(buf) - 1, fmt, a...);
+    buf[n] = '\n';
+    std::fwrite(buf, 1, n + 1, out());
+}
+}  // namespace fhetrace
+#endif
